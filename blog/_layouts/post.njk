---
layout: base.njk
---
{% from "responsive-image.njk" import responsiveImage %}

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": "{{ title }}",
  "author": {
    "@type": "Person",
    "name": "{{ site.author }}",
    "url": "{{ site.url }}"
  },
  "datePublished": "{{ date | safe }}",
  "dateModified": "{{ date | safe }}",
  "description": "{{ description }}",
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": "{{ site.url }}{{ page.url }}"
  },
  "keywords": "{% if tags %}{{ tags | join(', ') }}{% endif %}"
}
</script>

<article class="blog-post">
    <div class="container">
        <header class="post-header">
            <p class="post-kicker"><a href="/blog/">Writing</a><span aria-hidden="true"> / </span><time datetime="{{ page.date.toISOString().slice(0, 10) }}">{{ date | formatDate }}</time></p>
            <h1>{{ title }}</h1>
            {% if description %}<p class="post-dek">{{ description }}</p>{% endif %}
            {% if tags %}
            <ul class="post-tags">
                {% for tag in tags %}
                <li><a href="/blog/tags/{{ tag | slug }}/">#{{ tag }}</a></li>
                {% endfor %}
            </ul>
            {% endif %}
        </header>

        {% if featured_image %}
        <div class="post-featured-image">
            {{ responsiveImage(featured_image, title, "(min-width: 1200px) 1200px, 100vw") }}
        </div>
        {% endif %}

        <div class="post-content">
            {{ content | safe }}
        </div>

        {% set relatedPosts = page | getRelatedPosts(collections) %}
        {% if relatedPosts.length > 0 %}
        <aside class="related-posts" aria-labelledby="related-title">
            <h2 id="related-title" class="subhead">Related</h2>
            <ul>
                {% for related in relatedPosts %}
                <li>
                    <a href="{{ related.url }}" class="related-post-link">
                        <span class="related-title">{{ related.data.title }}</span>
                        {% if related.data.description %}<span class="related-desc">{{ related.data.description }}</span>{% endif %}
                    </a>
                </li>
                {% endfor %}
            </ul>
        </aside>
        {% endif %}

        {%- set previousPost = collections.posts | getPreviousCollectionItem %}
        {%- set nextPost = collections.posts | getNextCollectionItem %}
        <nav class="post-navigation" aria-label="More posts">
            {% if previousPost %}
            <a class="prev-post" href="{{ previousPost.url }}"><span class="subhead">Previous</span>{{ previousPost.data.title }}</a>
            {% else %}
            <span></span>
            {% endif %}
            {% if nextPost %}
            <a class="next-post" href="{{ nextPost.url }}"><span class="subhead">Next</span>{{ nextPost.data.title }}</a>
            {% else %}
            <a class="next-post" href="/blog/"><span class="subhead">Back to</span>All writing</a>
            {% endif %}
        </nav>
    </div>
</article>
