<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    {%- set pageTitle %}{% if title %}{{ title }} | {{ site.title }}{% else %}{{ site.title }} — {{ site.tagline }}{% endif %}{% endset %}
    {%- set pageDescription %}{% if description %}{{ description }}{% else %}{{ site.description }}{% endif %}{% endset %}
    <title>{{ pageTitle | safe }}</title>
    <meta name="description" content="{{ pageDescription | safe }}">
    <meta name="author" content="{{ site.author }}">
    {% if tags %}<meta name="keywords" content="{{ tags | join(', ') }}">{% endif %}
    {% if noindex %}<meta name="robots" content="noindex">{% else %}<link rel="canonical" href="{{ site.url }}{{ page.url }}">{% endif %}

    <!-- Open Graph / Social Media Meta Tags -->
    <meta property="og:title" content="{{ pageTitle | safe }}">
    <meta property="og:description" content="{{ pageDescription | safe }}">
    <meta property="og:type" content="{% if layout == 'post.njk' %}article{% else %}website{% endif %}">
    <meta property="og:url" content="{{ site.url }}{{ page.url }}">
    <meta property="og:site_name" content="{{ site.title }}">

    <!-- Twitter Card Meta Tags -->
    <meta name="twitter:card" content="summary">
    <meta name="twitter:title" content="{{ pageTitle | safe }}">
    <meta name="twitter:description" content="{{ pageDescription | safe }}">

    <meta name="color-scheme" content="light dark">
    <meta name="theme-color" content="#f6f5f1" media="(prefers-color-scheme: light)">
    <meta name="theme-color" content="#11110f" media="(prefers-color-scheme: dark)">
    <link rel="icon" href="/images/favicon.ico">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Inter:opsz,wght@14..32,400..600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
    {% if layout == 'post.njk' %}<link href="https://unpkg.com/prismjs@1.30.0/themes/prism-tomorrow.min.css" rel="stylesheet">{% endif %}
    <link rel="stylesheet" href="/assets/css/style.css">
    <link rel="stylesheet" href="/assets/css/blog.css">
    <script>document.documentElement.classList.add('js');</script>
</head>
<body id="top" class="{{ bodyClass }}">
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header" id="site-header">
        <div class="container header-inner">
            <a href="/" class="wordmark"><span class="wordmark-mark" aria-hidden="true"></span>Aimeri Baddouh</a>
            <button class="menu-toggle" id="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
                <span class="menu-toggle-label">Menu</span>
                <span class="menu-toggle-icon" aria-hidden="true"></span>
            </button>
            <nav class="site-nav" id="site-nav" aria-label="Main">
                <ul>
                    <li><a href="/#work">Work</a></li>
                    <li><a href="/#about">About</a></li>
                    <li><a href="/blog/"{% if page.url.startsWith('/blog') %} aria-current="page"{% endif %}>Writing</a></li>
                    <li><a href="/#contact">Contact</a></li>
                    <li><a href="https://aimeribaddouh.com" class="nav-external">Photography<span aria-hidden="true">&nbsp;↗</span></a></li>
                </ul>
            </nav>
        </div>
    </header>

    <main id="main">
        {{ content | safe }}
    </main>

    <footer class="site-footer">
        <div class="container footer-inner">
            <p class="footer-copy">&copy; {% year %} {{ site.author }}</p>
            <ul class="footer-links">
                <li><a href="{{ site.social.github }}">GitHub<span aria-hidden="true">&nbsp;↗</span></a></li>
                <li><a href="{{ site.social.huggingface }}">Hugging Face<span aria-hidden="true">&nbsp;↗</span></a></li>
                <li><a href="{{ site.social.linkedin }}">LinkedIn<span aria-hidden="true">&nbsp;↗</span></a></li>
                <li><a href="https://aimeribaddouh.com">Photography<span aria-hidden="true">&nbsp;↗</span></a></li>
            </ul>
            <a class="footer-top" href="#top">Back to top<span aria-hidden="true">&nbsp;↑</span></a>
        </div>
    </footer>

    <script type="module" src="/assets/js/main.js"></script>
</body>
</html>
